<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.FixIt.CardView.Glass"
    app:cardBackgroundColor="@android:color/transparent">

    <!-- The 'background' attribute here is what applies the glass effect -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_card_background"
        android:padding="@dimen/spacing_large">

        <!-- Content goes here -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This is a glass card!"
            style="@style/TextAppearance.FixIt.Subtitle" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
