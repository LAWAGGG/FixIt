<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_dark"
    android:orientation="vertical"
    android:padding="@dimen/spacing_large">

    <TextView
        style="@style/TextAppearance.FixIt.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_large"
        android:text="Select Payment Method" />

    <TextView
        android:id="@+id/payment_cash"
        style="@style/TextAppearance.FixIt.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:drawablePadding="@dimen/spacing_medium"
        android:focusable="true"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_medium"
        android:text="Cash"
        app:drawableStartCompat="@drawable/ic_cash" />

    <TextView
        android:id="@+id/payment_qris"
        style="@style/TextAppearance.FixIt.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:drawablePadding="@dimen/spacing_medium"
        android:focusable="true"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_medium"
        android:text="QRIS"
        app:drawableStartCompat="@drawable/ic_qris" />

    <TextView
        android:id="@+id/payment_bank_transfer"
        style="@style/TextAppearance.FixIt.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:drawablePadding="@dimen/spacing_medium"
        android:focusable="true"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_medium"
        android:text="Bank Transfer"
        app:drawableStartCompat="@drawable/ic_bank_transfer" />

</LinearLayout>
