<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".activities.CreateOrderActivity">

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white"
        app:title="Confirm Order"
        app:titleTextColor="@color/white"
        app:titleCentered="true"/>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/buttonPlaceOrder">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FixIt.CardView.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1AFFFFFF"
                app:strokeColor="#40FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <!-- Service Details Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/input_field_background">

                        <TextView
                            android:id="@+id/textViewServiceName"
                            style="@style/TextAppearance.FixIt.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:gravity="center"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Full Home Deep Cleaning" />

                        <TextView
                            android:id="@+id/textViewServicePrice"
                            style="@style/TextAppearance.FixIt.Subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/secondary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Rp 599.000" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Service Address"
                        android:textColor="@color/white"
                        android:layout_marginBottom="8dp"
                        android:layout_marginStart="4dp"/>

                    <EditText
                        android:id="@+id/editTextAddress"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/input_field_background"
                        android:hint="Enter full address"
                        android:inputType="textPostalAddress"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/white"
                        android:textColorHint="#80FFFFFF"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date &amp; Time"
                        android:textColor="@color/white"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:layout_marginStart="4dp"/>

                    <EditText
                        android:id="@+id/editTextOrderDate"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/input_field_background"
                        android:hint="Select date and time"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none"
                        android:paddingHorizontal="16dp"
                        android:drawableEnd="@drawable/ic_date"
                        android:drawableTint="@color/white"
                        android:textColor="@color/white"
                        android:textColorHint="#80FFFFFF"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notes / Problem Description"
                        android:textColor="@color/white"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:layout_marginStart="4dp"/>

                    <EditText
                        android:id="@+id/editTextNotes"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:background="@drawable/input_field_background"
                        android:hint="Tell the technician about your problem..."
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:padding="16dp"
                        android:textColor="@color/white"
                        android:textColorHint="#80FFFFFF"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Payment Method"
                        android:textColor="@color/white"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:layout_marginStart="4dp"/>

                    <TextView
                        android:id="@+id/textViewSelectedPayment"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/input_field_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="Tap to select payment"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:drawableEndCompat="@drawable/ic_arrow_right"
                        app:drawableTint="@color/white" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/buttonPlaceOrder"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_margin="24dp"
        android:text="Confirm Order"
        android:backgroundTint="@color/primary"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
